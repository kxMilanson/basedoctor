# BaseDoctor Environment Configuration

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/basedoctor?schema=public"

# Application Secret for JWT authentication (minimum 32 characters)
JWT_SECRET="basedoctor_jwt_super_secret_key_change_me_in_production_32chars!"

# Encryption key for Base.com API tokens (AES-256-GCM, must be exactly 32 bytes hex or 32 chars)
# Can be generated using: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
