datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum ConnectionStatus {
  ACTIVE
  INVALID_TOKEN
  RATE_LIMITED
  ERROR
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum IssueSeverity {
  CRITICAL
  WARNING
  INFO
}

enum IssueCategory {
  PRODUCT
  INVENTORY
  ORDER
  SHIPPING
  PRICING
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  name         String?
  role         Role             @default(USER)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  connections  ShopConnection[]
  scans        DiagnosticScan[]
  auditLogs    AuditLog[]

  @@map("users")
}

model ShopConnection {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  encryptedToken     String
  tokenIv            String
  tokenTag           String
  lastConnectedAt    DateTime?
  status             ConnectionStatus @default(ACTIVE)
  defaultInventoryId String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  scans              DiagnosticScan[]

  @@index([userId])
  @@map("shop_connections")
}

model DiagnosticScan {
  id                 String            @id @default(cuid())
  shopConnectionId   String
  shopConnection     ShopConnection    @relation(fields: [shopConnectionId], references: [id], onDelete: Cascade)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             ScanStatus        @default(PENDING)
  healthScore        Int               @default(100)
  productsScanned    Int               @default(0)
  ordersScanned      Int               @default(0)
  issuesCount        Int               @default(0)
  criticalCount      Int               @default(0)
  warningCount       Int               @default(0)
  infoCount          Int               @default(0)
  summary            Json?
  errorMessage       String?
  startedAt          DateTime          @default(now())
  completedAt        DateTime?
  issues             DiagnosticIssue[]

  @@index([userId])
  @@index([shopConnectionId])
  @@map("diagnostic_scans")
}

model DiagnosticIssue {
  id                 String         @id @default(cuid())
  scanId             String
  scan               DiagnosticScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  category           IssueCategory
  severity           IssueSeverity
  code               String
  title              String
  description        String
  affectedEntityId   String?
  affectedIdentifier String?
  details            Json?
  suggestedFix       String
  createdAt          DateTime       @default(now())

  @@index([scanId])
  @@index([severity])
  @@index([category])
  @@map("diagnostic_issues")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}
